# VCC-Covina Ingestion Backend Dockerfile
# Phase 1: Foundation Enhancement
# Multi-stage build for smaller, more secure images

# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim as runtime

# Security: Create non-root user
RUN groupadd -r covina && useradd -r -g covina covina

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder
COPY --from=builder /root/.local /home/covina/.local

# Copy application code
COPY --chown=covina:covina backends/ ./backends/
COPY --chown=covina:covina config/ ./config/
COPY --chown=covina:covina utils/ ./utils/
COPY --chown=covina:covina ingestion/ ./ingestion/
COPY --chown=covina:covina ai_judge/ ./ai_judge/
COPY --chown=covina:covina saga/ ./saga/

# Create data directories with proper permissions
RUN mkdir -p /app/data/uploads /app/logs /tmp && \
    chown -R covina:covina /app /tmp

# Switch to non-root user
USER covina

# Environment variables
ENV PATH=/home/covina/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV WORKERS_IO=36
ENV WORKERS_CPU=36

# Expose port
EXPOSE 45679

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:45679/health || exit 1

# Run the application
CMD ["uvicorn", "backends.ingestion_backend:app", "--host", "0.0.0.0", "--port", "45679", "--workers", "2"]
