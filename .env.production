# Covina Production Configuration
# ================================

# AUTHENTICATION & AUTHORIZATION (OAuth2/JWT + RBAC)
# Enable authentication (set to true for staging/production)
ENABLE_AUTH=false

# JWT Configuration
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET_256_BITS
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Demo Users (Replace with database-backed users in production)
ADMIN_PASSWORD=admin
USER_PASSWORD=user

# TLS/HTTPS CONFIGURATION
# Enforce HTTPS (redirect HTTP → HTTPS)
ENFORCE_HTTPS=false
HTTPS_PORT=443

# HSTS (Strict-Transport-Security) Headers
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# TLS Certificates (provide paths for production)
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

# mTLS (Mutual TLS) for Microservice Authentication
ENABLE_MTLS=false
VERIFY_CLIENT_CERT=false

# TLS Version and Ciphers
TLS_VERSION=TLSv1.2
TLS_CIPHERS=

# SECRETS MANAGEMENT
# Backend: dpapi (Windows DPAPI), keyvault (Azure KeyVault), env (development)
SECRETS_BACKEND=dpapi
AZURE_KEYVAULT_URL=

# PostgreSQL CONNECTION POOLING
# Thread-safe connection pool for improved database performance
# Expected Impact: -58% latency, +50-80% query throughput
POSTGRES_USE_POOL=true
POSTGRES_POOL_MIN_SIZE=10
POSTGRES_POOL_MAX_SIZE=100
POSTGRES_POOL_TIMEOUT=30

# WORKER POOL CONFIGURATION (Ingestion Backend)
# Basierend auf Load Test Ergebnissen vom 12.10.2025
# Load Test: 165 files/s @ 18 workers → Verdopplung für ~300-400 files/s

# I/O Workers (File Reading, Upload, DB Writes)
WORKERS_IO=36

# CPU Workers (AI Processing, Embeddings, Parsing)
WORKERS_CPU=36

# FASTAPI CONFIGURATION
# Multi-Worker Setup für höheren Query-Throughput
# Load Test: 280 queries/s @ 1 worker → Erwartung: 1000+ q/s @ 4 workers

# Ingestion Backend Workers (Port 45679)
INGESTION_WORKERS=4

# Main Backend Workers (Port 45678)
MAIN_WORKERS=8

# INGESTION HARDENING LIMITS (v3.5.0)
# Robuste Verarbeitung großer Datenmengen
MAX_FILES_PER_SCAN=50000
MAX_FILE_SIZE_MB=2048
MAX_TOTAL_SIZE_GB=100
SCAN_PROGRESS_INTERVAL=100
MAX_CHUNK_SIZE_FILES=50
MAX_CHUNK_SIZE_MB=1024
MAX_ACTIVE_JOBS=100

# DATABASE CONFIGURATION
POSTGRES_HOST=192.168.178.94
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CHROMADB_HOST=192.168.178.94
CHROMADB_PORT=8000

NEO4J_HOST=192.168.178.94
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=v3f3b1d7

# CouchDB (Document Database)
# Docker Port Mapping: 32769→4369/TCP, 32770→5984/TCP, 32771→9100/TCP
# CouchDB HTTP API läuft auf Port 5984 (gemapped auf Host-Port 32770)
COUCHDB_HOST=192.168.178.94
COUCHDB_PORT=32770
COUCHDB_USER=couchdb
COUCHDB_PASSWORD=couchdb

# BATCH EMBEDDINGS CONFIGURATION
# Aktiviert am 12.10.2025, 20:10 Uhr
# Expected Performance: +50-100% (CPU) oder +300-500% (GPU)
ENABLE_BATCH_EMBEDDINGS=true
BATCH_EMBEDDINGS_SIZE=32
BATCH_EMBEDDINGS_USE_GPU=true

# CHROMADB BATCH INSERT CONFIGURATION
# Aktiviert am 12.10.2025, 21:15 Uhr
# Expected Performance: +700% auf ChromaDB Insert (4,000ms → 500ms für 10 vectors)
ENABLE_CHROMA_BATCH_INSERT=true
CHROMA_BATCH_INSERT_SIZE=100

# NEO4J BATCH OPERATIONS CONFIGURATION
# Aktiviert am 16.10.2025, 21:45 Uhr
# Expected Performance: +15-25% Upload throughput (1000 rels/query with UNWIND)
ENABLE_NEO4J_BATCHING=true
NEO4J_BATCH_SIZE=1000

# ================================================================
# UDS3 PHASE 2: POSTGRESQL + COUCHDB BATCH OPERATIONS
# ================================================================
# Performance: +50-500x speedup for document ingestion
# PostgreSQL: 10 → 500-1000 docs/sec (+50-100x)
# CouchDB: 2 → 200-1000 docs/sec (+100-500x)
# Default: Disabled (set to "true" to activate)
# Activation Date: 20. Oktober 2025
# ================================================================

# PostgreSQL Batch Insert
ENABLE_POSTGRES_BATCH_INSERT=true   # Activated for Phase 2 batching
POSTGRES_BATCH_INSERT_SIZE=100      # Documents per batch (default: 100)

# CouchDB Batch Insert
ENABLE_COUCHDB_BATCH_INSERT=true    # Activated for Phase 2 batching
COUCHDB_BATCH_INSERT_SIZE=100       # Documents per batch (default: 100)

# ================================================================
# Activation Instructions:
# 1. Change ENABLE_*_BATCH_INSERT=false to true
# 2. Restart services: .\scripts\stop_services.ps1 && .\scripts\start_services.ps1
# 3. Verify in logs: "PostgreSQL Batch Inserter initialized"
# 4. Monitor performance: Check [STATS] messages in logs
# ================================================================

# LOGGING
LOG_LEVEL=INFO
