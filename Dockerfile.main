# Dockerfile für Covina Main Backend
# =====================================
# 
# Multi-stage build für optimale Image-Größe
# 
# Build:   docker build -f Dockerfile.main -t covina-main-backend:latest .
# Run:     docker run -p 45678:45678 covina-main-backend:latest
#
# Version: 1.0
# Date:    11. Oktober 2025

# ========================================
# STAGE 1: Builder (Dependencies)
# ========================================
FROM python:3.11-slim as builder

LABEL maintainer="Covina System"
LABEL description="Covina Main Backend - Queries, DSGVO, Review Queue"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ========================================
# STAGE 2: Runtime
# ========================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p logs data/sqlite_backup_20251007

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=45678

# Expose port
EXPOSE 45678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:45678/health || exit 1

# Run application
CMD ["python", "backend.py"]
