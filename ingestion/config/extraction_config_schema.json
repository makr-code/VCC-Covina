{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extraction Configuration",
  "type": "object",
  "properties": {
    "extraction_rules": {
      "type": "object",
      "properties": {
        "enabled_extractors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_entities_per_document": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "concept_synonyms": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nlp": {
      "type": "object",
      "properties": {
        "spacy_model": {
          "type": "string"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": ["extraction_rules"]
}
