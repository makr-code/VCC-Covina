# Environment Variables for Docker Deployment
# ==============================================
#
# Copy this file to .env and customize values
# Usage: cp .env.example .env
#
# Version: 2.1 (Microservices + WebSocket)
# Date: 11. Oktober 2025

# ========================================
# POSTGRESQL
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres  # Docker service name
POSTGRES_PORT=5432

# ========================================
# NEO4J (Graph Database)
# ========================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=v3f3b1d7
NEO4J_URI=neo4j://neo4j:7687  # Docker service name

# ========================================
# COUCHDB (Document Database)
# ========================================
COUCHDB_USER=couchdb
COUCHDB_PASSWORD=couchdb
COUCHDB_HOST=couchdb  # Docker service name
COUCHDB_PORT=5984

# ========================================
# CHROMADB (Vector Database)
# ========================================
CHROMADB_HOST=chromadb  # Docker service name
CHROMADB_PORT=8000

# ========================================
# BACKEND CONFIGURATION
# ========================================
MAIN_BACKEND_PORT=45678
INGESTION_BACKEND_PORT=45679

# Worker Pool (Ingestion Backend)
WORKERS_IO=18
WORKERS_CPU=18

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # or 'text'

# ========================================
# DEVELOPMENT / PRODUCTION
# ========================================
ENVIRONMENT=production  # or 'development', 'staging'
DEBUG=false

# ========================================
# OPTIONAL: EXTERNAL DATABASE HOSTS
# ========================================
# If using external databases instead of Docker services:
# POSTGRES_HOST=192.168.178.94
# NEO4J_URI=neo4j://192.168.178.94:7687
# CHROMADB_HOST=192.168.178.94
# COUCHDB_HOST=192.168.178.94
