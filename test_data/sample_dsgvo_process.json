{
  "process_id": "VPB_2025_002",
  "metadata": {
    "name": "DSGVO Auskunftsverfahren",
    "legal_context": "DSGVO Art. 15, BDSG § 34",
    "version": "1.5",
    "last_updated": "2025-09-15",
    "responsible_authority": "Datenschutzbeauftragter",
    "process_category": "data_protection"
  },
  "elements": [
    {
      "id": "elem_001",
      "name": "Auskunftsersuchen eingehend",
      "type": "event",
      "properties": {
        "description": "Betroffene Person stellt Auskunftsersuchen nach DSGVO Art. 15",
        "channels": ["E-Mail", "Brief", "Portal"],
        "knowledge_base_refs": ["DSGVO_Art15_Guideline"]
      }
    },
    {
      "id": "elem_002",
      "name": "Identitätsprüfung",
      "type": "task",
      "properties": {
        "description": "Verifizierung der Identität der betroffenen Person",
        "legal_basis": "DSGVO Art. 12 Abs. 6",
        "required_documents": ["Personalausweis", "Meldebestätigung"],
        "knowledge_base_refs": []
      }
    },
    {
      "id": "elem_003",
      "name": "Datensammlung",
      "type": "task",
      "properties": {
        "description": "Sammlung aller personenbezogenen Daten aus allen Systemen",
        "systems": ["CRM", "ERP", "Archiv"],
        "deadline_days": 30,
        "knowledge_base_refs": []
      }
    },
    {
      "id": "elem_004",
      "name": "Auskunft erstellen",
      "type": "task",
      "properties": {
        "description": "Zusammenstellung der Auskunft gemäß DSGVO Art. 15",
        "required_information": [
          "Zwecke der Verarbeitung",
          "Kategorien personenbezogener Daten",
          "Empfänger",
          "Speicherdauer",
          "Betroffenenrechte"
        ],
        "knowledge_base_refs": []
      }
    },
    {
      "id": "elem_005",
      "name": "Auskunft übermitteln",
      "type": "task",
      "properties": {
        "description": "Sichere Übermittlung der Auskunft an betroffene Person",
        "transmission_methods": ["Verschlüsselte E-Mail", "Einschreiben"],
        "knowledge_base_refs": []
      }
    },
    {
      "id": "elem_006",
      "name": "Dokumentation",
      "type": "task",
      "properties": {
        "description": "Dokumentation des Vorgangs für Rechenschaftspflicht",
        "retention_period": "3 Jahre",
        "knowledge_base_refs": []
      }
    }
  ],
  "flows": [
    {
      "id": "flow_001",
      "source": "elem_001",
      "target": "elem_002",
      "description": "Nach Eingang erfolgt Identitätsprüfung"
    },
    {
      "id": "flow_002",
      "source": "elem_002",
      "target": "elem_003",
      "condition": "Identität bestätigt",
      "description": "Bei erfolgreicher Identitätsprüfung wird Datensammlung gestartet"
    },
    {
      "id": "flow_003",
      "source": "elem_003",
      "target": "elem_004",
      "description": "Gesammelte Daten werden zu Auskunft zusammengestellt"
    },
    {
      "id": "flow_004",
      "source": "elem_004",
      "target": "elem_005",
      "description": "Fertige Auskunft wird übermittelt"
    },
    {
      "id": "flow_005",
      "source": "elem_005",
      "target": "elem_006",
      "description": "Vorgang wird dokumentiert"
    }
  ],
  "potential_gaps": [
    {
      "element": "elem_002",
      "issue": "Keine konkrete Methodik für Identitätsprüfung definiert",
      "severity": "high"
    },
    {
      "element": "elem_003",
      "issue": "Fehlende Prozedur für Vollständigkeitsprüfung der Datenquellen",
      "severity": "medium"
    },
    {
      "element": "elem_006",
      "issue": "Unklare Rechtsgrundlage für 3-jährige Aufbewahrungsfrist",
      "severity": "low"
    }
  ]
}
